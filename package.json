{
  "name": "sales-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "node scripts/validate-env.js && pnpm next dev",
    "build": "pnpm run build:patch-lock",
    "start": "pnpm next start",
    "lint": "eslint .",
    "build:patch-lock": "pnpm install --no-frozen-lockfile && pnpm next build",
    "test:smoke": "playwright test tests/smoke/",
    "test:smoke:ui": "playwright test tests/smoke/ --ui",
    "validate-env": "node scripts/validate-env.js"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.2.9",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "clsx": "^2.1.0",
    "crewai": "^1.0.1",
    "lucide-react": "^0.474.0",
    "next": "^16.2.4",
    "papaparse": "^5.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vercel": "^52.2.1"
  }
}